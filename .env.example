OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=120.0
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=1024
# Compatibilidad con configuraciones existentes; ya no se usa.
# Ambos modos clínicos usan OLLAMA_NUM_PREDICT.
OLLAMA_DUAL_NUM_PREDICT=1024
OLLAMA_NUM_CTX=8192
OLLAMA_REPEAT_PENALTY=1.0
OLLAMA_TOP_P=0.8
OLLAMA_TOP_K=20
OLLAMA_MIN_P=0.0
OLLAMA_SEED=42
OLLAMA_MAX_RETRIES=2
MAX_CONCURRENT=1
QUEUE_WAIT_TIMEOUT=30.0
HOST=127.0.0.1
PORT=8888
API_KEY=cambia-este-token-por-uno-seguro
MAX_SENTENCES=10
CACHE_TTL_SECONDS=86400
CACHE_MAX_SIZE=500
HEALTH_CHECK_TIMEOUT=5.0
HEALTH_CACHE_SEGUNDOS=2.0
DOCS_HABILITADOS=false
MAX_CUERPO_BYTES=1048576
LOG_LEVEL=INFO
MAX_QUEUE_SIZE=5

# Seguimiento WhatsApp: opciones por llamada y presupuesto total LLM.
SEGUIMIENTO_LLM_HABILITADO=true
# SEGUIMIENTO_TEMPERATURE=0.4
# SEGUIMIENTO_NUM_PREDICT=320
# VERIFICACION_NUM_PREDICT=32
# SEGUIMIENTO_TIMEOUT=45.0
# FONDO_QUEUE_WAIT_TIMEOUT=10.0
# Con SEGUIMIENTO_LLM_HABILITADO=false responde plantilla del catálogo antes de consultar caché y sin llamar a Ollama.
# MAX_CONCURRENT debe ser 1 y uvicorn debe usar un solo worker.

LIMITE_CONTEXTO_TOKENS=8192
PRESUPUESTO_RECETA_SIN_EXACTO=conservador

# Explicación al paciente dentro de clinica-paciente-v1 (W1b).
PACIENTE_LLM_HABILITADO=true
PACIENTE_TIMEOUT_REDACCION_S=15
PACIENTE_TIMEOUT_VERIFICACION_S=5
PACIENTE_MINIMO_REDACCION_S=1
PACIENTE_MINIMO_VERIFICACION_S=0.5
PLAZO_GLOBAL_RECETA_S=85
PACIENTE_OMITIR_SI_ESPERA=true
# Plazos positivos. Reserva CPU fija: 0.1 s. Global desde llegada, incluida cola.
# false evita llamadas y prosa cacheada del paciente; motivo nulo en respaldo
# salvo fallo de ensamblado (rechazada/error).
